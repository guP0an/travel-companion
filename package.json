{
  "name": "travel-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm backend:build",
    "test": "tsc -b && pnpm backend:build && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "backend:build": "tsc -p server/tsconfig.json",
    "backend:dev": "pnpm backend:build && node --env-file-if-exists=.env.local server/index.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.108.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.3",
    "motion": "^13.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
