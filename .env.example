# 复制为 .env.local 并填入真实值。此文件不含密钥，可提交。
# 密钥仅服务端（serverless 代理）读取，不要加 VITE_ 前缀。

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德 Web 服务 API（可选；未配置时自动跳过 POI/路线核验）
AMAP_WEB_SERVICE_KEY=

# Supabase（可公开，靠 RLS 保护；service_role key 绝不放此处）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
