# 复制为 .env.local 并填入真实值。此文件不含密钥，可提交。
# 密钥仅服务端（serverless 代理）读取，不要加 VITE_ 前缀。

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德 Web 服务 API（可选；未配置时自动跳过 POI/路线核验）
AMAP_WEB_SERVICE_KEY=

# 和风天气当前灾害预警（可选；需使用控制台分配的专属 API Host）
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# 手机验证码（可选；短信资质审核通过后配置）
SUPABASE_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# Supabase（可公开，靠 RLS 保护；service_role key 绝不放此处）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
