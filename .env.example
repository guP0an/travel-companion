# 复制为 .env.local 并填入真实值。此文件不含密钥，可提交。
# 密钥仅服务端（serverless 代理）读取，不要加 VITE_ 前缀。

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Kimi K2.6 视觉识别（票务/酒店截图）
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6

# 高德 Web 服务 API（可选；未配置时自动跳过 POI/路线核验）
AMAP_WEB_SERVICE_KEY=

# 和风天气当前灾害预警（可选；需使用控制台分配的专属 API Host）
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# 手机验证码（可选；短信资质审核通过后配置）
SUPABASE_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 微信小程序登录（仅服务端；AppSecret、管理 Key、私钥绝不放进小程序或 VITE_ 变量）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信内网页授权（公众号）与 PC 扫码（开放平台网站应用）
WECHAT_H5_APP_ID=
WECHAT_H5_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
# OAuth state 签名密钥和固定生产来源；均仅服务端读取
WECHAT_OAUTH_STATE_SECRET=
WECHAT_OAUTH_ORIGIN=https://wanwantrip.online
WECHAT_IDENTITY_PEPPER=
SUPABASE_SECRET_KEY=
# 与 Supabase Dashboard 导入并启用的 ES256 Signing Key 为同一份私有 JWK JSON。
SUPABASE_JWT_PRIVATE_JWK=
WECHAT_TOKEN_TTL_SECONDS=3600

# Supabase（可公开，靠 RLS 保护；service_role key 绝不放此处）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
