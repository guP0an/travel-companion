{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "node_modules/.tmp-tsnode"
  },
  "include": ["vite.config.ts", "api/**/*.ts", "shared/**/*.ts"]
}
