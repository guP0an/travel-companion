.page-shell {
  min-height: 100vh;
  padding: 48rpx 40rpx 56rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid #292821;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b44838;
  font-family: serif;
  font-size: 30rpx;
}

.brand-name {
  font-family: serif;
  font-size: 34rpx;
}

.brand-subtitle {
  margin-top: 2rpx;
  color: #9b9485;
  font-size: 22rpx;
}

.login-main {
  margin-top: 28vh;
}

.eyebrow {
  color: #3f8792;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.title {
  max-width: 560rpx;
  margin-top: 22rpx;
  font-family: serif;
  font-size: 54rpx;
  line-height: 1.32;
}

.summary {
  margin-top: 24rpx;
  color: #746f64;
  font-size: 27rpx;
  line-height: 1.8;
}

.login-button {
  width: 100%;
  height: 94rpx;
  margin-top: 64rpx;
  border-radius: 4rpx;
  background: #292821;
  color: #fffdf6;
  font-size: 29rpx;
  line-height: 94rpx;
}

.success-line {
  margin-top: 64rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid #3f8792;
  color: #3f8792;
  font-size: 28rpx;
}

.message {
  margin-top: 20rpx;
  color: #b44838;
  font-size: 24rpx;
}

.privacy-note {
  margin-top: auto;
  color: #aaa394;
  font-size: 21rpx;
  line-height: 1.7;
}
